# Sandboxed execution container — §11 (Sandboxed Execution Infrastructure).
#
# Minimal read-only base. The supervisor mounts /workspace as a writable
# tmpfs overlay per §11.1. Only a small set of dev tools is pre-installed
# so the denylist in §11.2 stays effective (no shell pipelines that could
# smuggle in `curl | bash`).
FROM node:20-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    git python3 python3-pip python3-venv \
    ca-certificates curl jq ripgrep \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -r -u 1000 -g root sandbox

# Pre-install common test/lint tools so the supervisor can run them
# without re-downloading per run. Uses @biomejs/biome (not the deprecated
# 'biome' package) and installs Python tools into a venv to avoid
# PEP 668 "externally managed environment" errors on Bookworm.
RUN npm install -g vitest@3 @biomejs/biome@2 typescript@7 tsx@4 \
    && python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --upgrade pip \
    && /opt/venv/bin/pip install --no-cache-dir ruff mypy pytest \
    && ln -s /opt/venv/bin/ruff /usr/local/bin/ruff \
    && ln -s /opt/venv/bin/mypy /usr/local/bin/mypy \
    && ln -s /opt/venv/bin/pytest /usr/local/bin/pytest

ENV PATH="/opt/venv/bin:${PATH}"

# Workspace is mounted here at runtime
RUN mkdir -p /workspace && chown sandbox:root /workspace
WORKDIR /workspace

USER sandbox

# Default to a no-op; the supervisor always overrides Cmd.
CMD ["echo", "supervisor-sandbox ready"]
