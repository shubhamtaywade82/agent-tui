# ============================================================
# MiniCPM5 Supervisor — Environment Configuration
# Copy relevant lines into the project `.env` file (already git-ignored).
# ============================================================

# ---- Supervisor service ----------------------------------------------------
# Loopback by default. Docker compose overrides this to 0.0.0.0 inside the container.
SUPERVISOR_HTTP_HOST=127.0.0.1
SUPERVISOR_HTTP_PORT=7480
# Bearer token for every route except /v1/healthz and /docs. At least 16 characters.
# Required when SUPERVISOR_HTTP_HOST is not loopback; unset on loopback generates one per run.
SUPERVISOR_API_KEY=
# Comma-separated browser origins allowed to call the API. Empty disables CORS.
SUPERVISOR_CORS_ORIGINS=
SUPERVISOR_LOG_LEVEL=info
SUPERVISOR_LOG_FORMAT=pretty

# ---- Inference backend -----------------------------------------------------
# ollama | vllm | mock
INFERENCE_BACKEND=ollama
OLLAMA_HOST=http://localhost:11434
# vLLM OpenAI-compatible endpoint (when INFERENCE_BACKEND=vllm)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=local

# ---- MiniCPM5 model endpoints ----------------------------------------------
MINICPM5_ROUTER_MODEL=minicpm5-router
MINICPM5_TOOL_MODEL=minicpm5-toolagent
MINICPM5_ANALYST_MODEL=minicpm5-analyst
MINICPM5_SUMMARIZER_MODEL=minicpm5-summarizer

# Hybrid Think / No-Think mode (§13.3)
MINICPM5_DEFAULT_THINK_MODE=no-think

# ---- Model residency pool (Phase 2) ----------------------------------------
# At most N MiniCPM5 variants resident in Ollama at any time. The pool
# evicts the LRU non-pinned resident before loading a fourth model.
# Leave the allowlist empty to disable residency management entirely.
MODEL_POOL_MAX_RESIDENT=3
# Ollama keep_alive in ms after a model is loaded (default 5 min).
MODEL_POOL_KEEP_ALIVE_MS=300000
# Comma-separated model names the pool manages. Models not on the
# allowlist (e.g. the cloud fallback) pass through acquire() as a no-op
# and do NOT count toward the cap. Recommended:
#   minicpm5-router,minicpm5-toolagent,minicpm5-analyst,minicpm5-summarizer
MODEL_POOL_ALLOWLIST=minicpm5-router,minicpm5-toolagent,minicpm5-analyst,minicpm5-summarizer
# When "true", the pool polls /api/ps on every acquire() to refresh its
# residency cache. Default false (production) to avoid extra round-trips;
# set to "true" in tests for determinism.
MODEL_POOL_ALWAYS_REFRESH=false

# ---- PostgreSQL (operational state — §4) -----------------------------------
DATABASE_URL=postgres://supervisor:supervisor@localhost:5432/supervisor

# ---- Redis (working memory + queues — §7.1) --------------------------------
REDIS_URL=redis://localhost:6379/0

# ---- Object storage (§5 — file abstraction) --------------------------------
# local | s3 | minio
OBJECT_STORE_KIND=minio
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=supervisor-artifacts
MINIO_REGION=us-east-1

# ---- Sandbox executor (§11) ------------------------------------------------
SANDBOX_IMAGE=supervisor-sandbox:latest
SANDBOX_NETWORK=supervisor-net
SANDBOX_CPU_LIMIT=1.0
SANDBOX_MEMORY_LIMIT_MB=512
SANDBOX_TIMEOUT_MS=30000
SANDBOX_WORK_DIR=/workspace

# ---- Context budget (§8.2) -------------------------------------------------
CONTEXT_BUDGET_TOKENS=8192
CONTEXT_RESERVE_TOKENS=512

# ---- Retrieval (§6) --------------------------------------------------------
RETRIEVAL_TOP_K=5
RETRIEVAL_RERANK=true
RETRIEVAL_MIN_SCORE=0.35

# ---- Embedding provider (Phase 4) -----------------------------------------
# When EMBEDDING_MODEL is set and the Ollama backend is active, the
# OllamaEmbedder calls /api/embed to produce query embeddings at retrieve
# time and chunk embeddings at ingest time. Without an embedder, the
# retriever silently degrades to keyword-only search; GET /v1/healthz
# reports retrievalMode: 'keyword-only' so the operator can see the gap.
#
# Pull the model before first run: `ollama pull nomic-embed-text`
EMBEDDING_MODEL=nomic-embed-text
# Vector dimension. MUST match the model's output dimension:
#   nomic-embed-text: 768 (default)
#   bge-m3:           1024
#   mxbai-embed-large: 1024
# The retriever validates this against the live chunks table schema on
# init() and warns on mismatch — change this only when re-creating the
# chunks table to match.
EMBEDDING_DIMENSION=768
# Max texts per /api/embed call. Larger batches are more efficient but
# use more VRAM.
EMBEDDING_BATCH_SIZE=32
# Truncate inputs longer than the model's max context. Set to "false"
# to disable truncation (an over-long input then returns an error).
EMBEDDING_TRUNCATE=true
# Stable version label stored on each chunk at ingest time. Bump this
# when the embedder changes (model swap, dimension change) so old chunks
# can be identified and re-indexed.
EMBEDDING_MODEL_VERSION=nomic-embed-text-v1

# ---- Memory (§7) -----------------------------------------------------------
MEMORY_EPISODIC_TTL_DAYS=30
MEMORY_IMPORTANCE_THRESHOLD=0.6

# ---- Task planner (Phase 3) ------------------------------------------------
# Bounds applied to the TaskPlanner's auto-decomposition output. The
# planner asks the router variant to emit the initial task graph for a
# goal; these keep the model's output deterministic and bounded.
PLANNER_MAX_TASKS_PER_GOAL=20
# Longest dependency chain permitted. Deeper chains indicate
# over-decomposition — split the goal into sub-goals instead.
PLANNER_MAX_DEPTH=5
# Number of repair attempts when the model emits schema-invalid output.
# After this, the planner throws TaskPlannerError (HTTP 422) — never
# silently accepts malformed output.
PLANNER_MAX_REPAIR_ATTEMPTS=1

# ---- Patch workflow (Phase 5) ----------------------------------------------
# When a CODE_CHANGE task is run, the orchestrator asks the analyst model
# for a structured patch proposal, validates it against PatchProposalSchema,
# applies it via PatchWorkflow in an isolated git worktree, and runs the
# configured verifyCommands. The task can only be SUCCEEDED if verification
# passes — the model's claim that "tests passed" is not accepted as evidence.
#
# Default verify commands appended to every patch's verification list.
# The model cannot skip these. Separate multiple commands with "||".
PATCH_DEFAULT_VERIFY_COMMANDS=npm run supervisor:typecheck||npm run supervisor:lint||npm run supervisor:test
# Hard cap on the number of files a single patch may touch.
PATCH_MAX_FILES=20
# Hard cap on the total bytes of file content in a single patch.
PATCH_MAX_BYTES=1048576
# Clean up the worktree after the patch is applied and verified.
# Set to "false" for debugging to inspect the worktree's state.
PATCH_CLEANUP_WORKTREE=true

# ---- Escalation (§13.1) ----------------------------------------------------
ESCALATION_MAX_RETRIES=2
ESCALATION_FALLBACK_MODEL=
# OpenAI-compatible endpoint for the larger fallback model
ESCALATION_FALLBACK_BASE_URL=
ESCALATION_FALLBACK_API_KEY=

# ---- Security (§16) --------------------------------------------------------
SUPERVISOR_JWT_SECRET=change-me-in-production
SUPERVISOR_REQUIRE_APPROVAL_FOR=production_deploy,database_migration,external_payment,send_email,secret_access,privileged_terminal,irreversible_api
SUPERVISOR_RATE_LIMIT_PER_MIN=120

# ---- Observability (§15) ---------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=minicpm5-supervisor
OTEL_ENABLED=false

# ---- Test / CI -------------------------------------------------------------
TEST_DATABASE_URL=postgres://supervisor:supervisor@localhost:55432/supervisor_test
TEST_REDIS_URL=redis://localhost:6379/1
