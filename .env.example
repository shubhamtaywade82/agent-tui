# ============================================================
# Agentic TUI — Environment Configuration Template
# Copy to `.env` and fill in your credentials. `.env` is git-ignored.
# ============================================================

# ---- Provider selection -----------------------------------------------------
# Which provider is active by default: ollama | openai | anthropic | zai
AGENT_PROVIDER=ollama

# ---- Agent behaviour --------------------------------------------------------
AGENT_MAX_ITERATIONS=12
AGENT_WALL_TIME_MS=120000
AGENT_CONTEXT_BUDGET=12000
# Model window (Ollama num_ctx) — history budget is derived: num_ctx - tools - reserve
AGENT_NUM_CTX=32768
AGENT_CONTEXT_RESERVE=4096
# Block identical tool calls after N successes (stops re-read loops under compaction)
AGENT_TOOL_REPEAT_LIMIT=2
AGENT_TEMPERATURE=0.7
AGENT_THINKING=true
# Unattended TUI: auto-continue plan steps / turn limits (or use --auto / --yolo on launch)
# AGENT_AUTO=1
# AGENT_AUTO_MAX_CHAINS=50
# Comma-separated tool names, or "all"
AGENT_TOOLS=all
# MCP servers: "all" | "none" | comma-separated ids (memory,filesystem,time,fetch,git,sequential-thinking,binance-sdk)
AGENT_MCP=all
AGENT_LOG_LEVEL=info
AGENT_LOG_FILE=.agent/logs/agent.log
AGENT_SESSIONS_DIR=.agent/sessions

# ---- Ollama (local + cloud) -------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# Ollama Cloud (https://ollama.com) — Bearer token from your account
# OLLAMA_API_KEY=your-ollama-cloud-api-key
# OLLAMA_CLOUD_URL=https://ollama.com
# Models that only run on cloud (SDK routes these to the cloud endpoint)
# OLLAMA_CLOUD_MODELS=gpt-oss:120b,minimax-m3
# Optional: restrict which models use local GPU only
# OLLAMA_LOCAL_MODELS=qwen3:8b,qwen3:4b
# Bigger cloud model used when AGENT_OLLAMA_ROUTING=auto detects a heavy task
# OLLAMA_CLOUD_MODEL=gpt-oss:120b
# local-first | cloud-first | auto (task-based escalation to OLLAMA_CLOUD_MODEL)
AGENT_OLLAMA_ROUTING=local-first
# AGENT_OLLAMA_AUTO_ESCALATE_SCORE=0.35
# Mid-run: switch to OLLAMA_CLOUD_MODEL after N tool calls or iterations (auto mode)
# AGENT_OLLAMA_ESCALATE_AFTER_TOOLS=6
# AGENT_OLLAMA_ESCALATE_AFTER_ITER=3
# Optional tiny local model to classify borderline tasks (hybrid | model | heuristic)
# OLLAMA_ROUTER_MODEL=qwen3:0.6b
# AGENT_OLLAMA_ROUTER=hybrid

# ---- OpenAI-compatible ------------------------------------------------------
# OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---- Anthropic-compatible ---------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ---- Z.ai (GLM) SDK ---------------------------------------------------------
# Get a key at https://z.ai
# ZAI_API_KEY=your-zai-key
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-4.6

# ---- GitHub (for repo analysis / clone tools) -------------------------------
# Supplied at runtime via github-token.txt; do NOT paste here unless you know
# the file stays git-ignored.
# GITHUB_TOKEN=ghp_...

# ---- Binance (optional) -----------------------------------------------------
# BINANCE_OAUTH_TOKEN=
# BINANCE_MCP_URL=https://agent.binance.com/mcp/agentic

# ---- Skills pack (optional) -------------------------------------------------
# SKILLS_PATH=/home/you/projects/agent-skills/ruby-agent-skills
