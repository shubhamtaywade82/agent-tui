{
  "name": "agentic-tui",
  "version": "2.0.0",
  "description": "Agentic TUI + Headless CLI + API server — multi-provider AI agent (Ollama, OpenAI, Anthropic, Z.ai) with MCP, RAG, multimodal tools, and session persistence",
  "main": "src/index.ts",
  "bin": {
    "agent-tui": "src/index.ts"
  },
  "scripts": {
    "start": "tsx src/index.tsx",
    "dev": "tsx watch src/index.tsx",
    "tui": "tsx src/index.tsx",
    "cli": "tsx src/index.ts",
    "run": "tsx src/index.ts run",
    "repl": "tsx src/index.ts repl",
    "serve": "tsx src/index.ts serve",
    "doctor": "tsx src/index.ts doctor",
    "demo": "tsx src/index.ts run 'Use the calculator tool to compute 125 * 38 and explain the result.'",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/tasks.test.ts"
  },
  "keywords": [
    "ai",
    "agent",
    "ollama",
    "tui",
    "ink",
    "mcp"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@nemesis-oss/agentic-runtime": "^0.2.1",
    "@nemesis-oss/binance-sdk": "^2.0.0",
    "@nemesis-oss/ollama-sdk": "^1.7.0",
    "dotenv": "^17.4.2",
    "ink": "^7.1.1",
    "react": "^19.3.0",
    "z-ai-web-dev-sdk": "^0.0.18",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2"
  }
}
